{
  "id": "night-sakura",
  "layout": "card",
  "mode": "dark",
  "tokens": {
    "--color-accent": "#ff8fb8",
    "--color-accent-soft": "rgba(255, 143, 184, 0.16)",
    "--accent-fill": "#c2407a",
    "--accent-fill-hover": "#d04c88",
    "--text-on-accent": "#ffffff",
    "--selection-bg": "rgba(255, 143, 184, 0.35)",
    "--selection-fg": "#ffffff",
    "--sidebar-gradient": "linear-gradient(180deg, #2b1923 0%, #1d1218 100%)",
    "--sidebar-border": "rgba(255, 200, 225, 0.06)",
    "--surface-app": "#170f14",
    "--surface-card": "#221720",
    "--surface-card-elevated": "#261a23",
    "--surface-overlay": "rgba(38, 26, 35, 0.97)",
    "--surface-1": "#2b1e28",
    "--surface-2": "#1f151b",
    "--surface-tooltip": "rgba(58, 38, 50, 0.97)",
    "--text-on-tooltip": "#ffffff",
    "--surface-backdrop": "rgba(8, 4, 6, 0.55)",
    "--pill-bg": "rgba(255, 143, 184, 0.14)",
    "--pill-blur": "none",
    "--pill-shadow": "0 0 0 1px rgba(255, 143, 184, 0.18) inset, 0 2px 8px rgba(0, 0, 0, 0.3)",
    "--hover-bg": "rgba(255, 200, 225, 0.06)",
    "--text-strong": "#f6eaf0",
    "--text-regular": "#e3d1da",
    "--text-muted": "#b49ca8",
    "--text-faint": "#927a86",
    "--text-on-pill": "#ffc2d8",
    "--status-ok": "#5fd39a",
    "--status-pending": "#f2b55c",
    "--status-idle": "#927a86",
    "--status-error": "#ff7a6b",
    "--status-info": "#8fb0ff",
    "--status-ok-soft": "rgba(95, 211, 154, 0.16)",
    "--status-error-soft": "rgba(255, 122, 107, 0.16)",
    "--status-pending-soft": "rgba(242, 181, 92, 0.16)",
    "--status-info-soft": "rgba(143, 176, 255, 0.16)",
    "--status-ok-strong": "#7ee0ad",
    "--status-error-strong": "#ff9a8e",
    "--status-pending-strong": "#f7c77c",
    "--status-info-strong": "#a9c2ff",
    "--border-subtle": "rgba(255, 200, 225, 0.07)",
    "--border-default": "rgba(255, 200, 225, 0.11)",
    "--border-strong": "rgba(255, 200, 225, 0.17)",
    "--border-dashed": "rgba(255, 200, 225, 0.24)",
    "--fill-subtle": "rgba(255, 200, 225, 0.045)",
    "--fill-default": "rgba(255, 200, 225, 0.075)",
    "--fill-strong": "rgba(255, 200, 225, 0.11)",
    "--toggle-track": "rgba(255, 200, 225, 0.2)",
    "--toggle-track-hover": "rgba(255, 200, 225, 0.28)",
    "--toggle-thumb": "#f6eaf0",
    "--scrollbar-thumb": "rgba(255, 200, 225, 0.18)",
    "--scrollbar-thumb-hover": "rgba(255, 200, 225, 0.32)",
    "--hairline-hi": "rgba(255, 255, 255, 0.04)",
    "--control-bg": "rgba(255, 200, 225, 0.05)",
    "--control-bg-hover": "rgba(255, 200, 225, 0.09)",
    "--shadow-rgb": "0, 0, 0",
    "--shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "--shadow-md": "0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 20px rgba(0, 0, 0, 0.35)",
    "--shadow-lg": "0 16px 40px rgba(0, 0, 0, 0.55), 0 2px 8px rgba(0, 0, 0, 0.4)",
    "--shadow-inset-hi": "0 1px 0 rgba(255, 255, 255, 0.04) inset",
    "--radius-xs": "6px",
    "--radius-sm": "10px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px"
  },
  "css": "[data-part=\"sidebar\"] {\n  --hairline-hi: transparent;\n}\n\n[data-part=\"content\"] {\n  background: var(--surface-app);\n}\n\n/* Switches and sliders glow a little brighter than text links. */\n[data-part=\"toggle\"],\n[data-part=\"slider\"] {\n  --color-accent: #ff7fae;\n}\n\n[data-part=\"ranked-list\"] {\n  font-variant-numeric: tabular-nums;\n}\n"
}
