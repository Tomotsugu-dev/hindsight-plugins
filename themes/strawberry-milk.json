  "css": "[data-part=\"sidebar\"] {\n  --hover-bg: rgba(255, 255, 255, 0.6);\n  --hairline-hi: transparent;\n}\n\n[data-part=\"content\"] {\n  background: var(--surface-app);\n}\n\n/* Cards get a pink edge, like a frosted cake. */\n[data-part=\"card\"] {\n  border-color: var(--border-default);\n}\n\n[data-part=\"ranked-list\"] {\n  font-variant-numeric: tabular-nums;\n}\n"
}
