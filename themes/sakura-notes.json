{
  "id": "sakura-notes",
  "layout": "card",
  "mode": "light",
  "tokens": {
    "--color-accent": "#b33870",
    "--color-accent-soft": "#ffe3ef",
    "--sidebar-gradient": "linear-gradient(165deg, #ffe1ee 0%, #ffedf5 55%, #ffe4f2 100%)",
    "--sidebar-border": "#ffd9ea",
    "--surface-app": "#fff2f8",
    "--surface-card": "#fff3f9",
    "--surface-card-elevated": "#fffdfd",
    "--surface-overlay": "rgba(255, 250, 253, 0.98)",
    "--surface-1": "#fffdfd",
    "--surface-2": "#ffeef6",
    "--pill-bg": "#fff9fc",
    "--pill-blur": "none",
    "--pill-shadow": "0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 4px 16px rgba(236, 133, 174, 0.14)",
    "--hover-bg": "rgba(255, 255, 255, 0.5)",
    "--text-strong": "#4e3441",
    "--text-regular": "#634854",
    "--text-muted": "#735361",
    "--text-faint": "#7d5c6b",
    "--text-on-pill": "#b33870",
    "--status-ok": "#206346",
    "--status-pending": "#80500b",
    "--status-idle": "#625464",
    "--status-error": "#ad3c6b",
    "--status-ok-soft": "rgba(32, 99, 70, 0.1)",
    "--status-error-soft": "#ffe3ed",
    "--status-pending-soft": "rgba(128, 80, 11, 0.1)",
    "--border-subtle": "#fff0f6",
    "--border-default": "#fbe1ec",
    "--border-strong": "#edaec9",
    "--scrollbar-thumb": "rgba(219, 101, 148, 0.25)",
    "--scrollbar-thumb-hover": "rgba(219, 101, 148, 0.42)",
    "--hairline-hi": "rgba(255, 255, 255, 0.9)",
    "--control-bg": "#fffafd",
    "--control-bg-hover": "#ffeef6",
    "--shadow-strength": "0.3",
    "--shadow-sm": "0 2px 8px rgba(232, 140, 180, 0.06)",
    "--shadow-md": "0 1px 0 rgba(255, 255, 255, 0.95) inset, 0 10px 30px rgba(232, 140, 180, 0.09)",
    "--shadow-lg": "0 18px 48px rgba(216, 119, 159, 0.16)",
    "--shadow-inset-hi": "0 1px 0 rgba(255, 255, 255, 0.9) inset",
    "--radius-xs": "8px",
    "--radius-sm": "12px",
    "--radius-md": "20px",
    "--radius-lg": "24px",
    "--radius-xl": "28px"
  },
  "css": "/* Milky pink surfaces and soft white highlights. */\n[data-part=\"sidebar\"] {\n  box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.65);\n}\n\n[data-part=\"nav-item\"][aria-current=\"page\"] {\n  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.85);\n  font-weight: 600;\n}\n\n/* Rounded cream cards float on the blush canvas without a dark outline. */\n[data-part=\"card\"] {\n  border: 1px solid #ffeaf3;\n  border-radius: 24px;\n  box-shadow: var(--shadow-md);\n}\n\n/* Graphic controls can use a lighter pink than small text and account labels. */\n[data-part=\"toggle\"],\n[data-part=\"slider\"] {\n  --color-accent: #db6594;\n}\n\n[data-part=\"drawer\"],\n[data-part=\"dialog\"] {\n  box-shadow: var(--shadow-lg);\n}\n"
}
